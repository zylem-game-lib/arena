{
  "name": "@zylem/arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone Zylem arena example.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zylem-game-lib/arena.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "moba": "node scripts/moba.mjs",
    "dev": "vite --host",
    "build": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server:build": "sh server/scripts/run-spacetimedb-cli.sh build -p server/spacetimedb",
    "server:generate:bindings": "sh server/scripts/run-spacetimedb-cli.sh generate --lang typescript -o src/spacetimedb-generated -p server/spacetimedb -y",
    "server:publish:arena": "sh server/scripts/run-spacetimedb-cli.sh publish arena -s local -p server/spacetimedb",
    "server:start": "bash server/scripts/start-spacetimedb-server.sh",
    "server:dev": "pnpm run server:build && pnpm run server:publish:arena"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@vanilla-extract/css": "^1.20.1",
    "@zylem/assets": "^0.1.1",
    "@zylem/behaviors": "^0.3.0",
    "@zylem/game-lib": "^0.7.0",
    "@zylem/styles": "file:../zylem/packages/zylem-styles",
    "nanoid": "^5.1.15",
    "solid-js": "^1.9.13",
    "spacetimedb": "2.1.0",
    "three": "^0.184.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.6.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.184.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-glsl": "^1.6.0",
    "vite-plugin-solid": "^2.11.12"
  },
  "pnpm": {
    "overrides": {
      "@dimforge/rapier3d-compat": "0.11.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@zylem/behaviors>three": "0.184.0"
      }
    }
  },
  "packageManager": "pnpm@10.33.0"
}
